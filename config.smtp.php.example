return [
    'host' => 'smtp.example.com',
    'port' => 587,
    'encryption' => 'tls',          // 'tls' = STARTTLS (typically port 587), 'ssl' = implicit TLS (typically port 465)
    'username' => 'your-smtp-username',
    'password' => 'your-smtp-password',
    'from' => 'feedback@example.com',
    'from_name' => 'Meh Feedback',
    'to' => 'you@example.com',      // where notifications are sent
];
